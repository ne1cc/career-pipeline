<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd job for the JobSpy Custom pipeline.

  This replaces the Linux crontab entry:
    daily at 8:00 AM Pacific using this project's Python environment

  launchd is the macOS-native way to run this daily (cron exists on macOS
  but needs manual Full Disk Access grants and doesn't run missed jobs on
  wake); a LaunchAgent runs as your user, at login or on a schedule, and
  catches up a missed run if the Mac was asleep at the scheduled time.

  BEFORE INSTALLING, replace every REPLACE_WITH_* placeholder below:
    - REPLACE_WITH_HOME_DIR       e.g. /Users/yourname
    - REPLACE_WITH_REPO_PATH      absolute path to this cloned repo,
                                   e.g. /Users/yourname/Github/ne1cc/career-pipeline
    - REPLACE_WITH_PYTHON_PATH    absolute path to the project's Python,
                                   e.g. /Users/yourname/.local/venvs/jobspy/bin/python

  Then install with (copy first — do not sed this template in git):
    cp launchd/com.jobspy-custom.pipeline.plist ~/Library/LaunchAgents/
    sed -i '' "s|REPLACE_WITH_REPO_PATH|/Users/yourname/Github/ne1cc/career-pipeline|g; s|REPLACE_WITH_HOME_DIR|/Users/yourname|g; s|REPLACE_WITH_PYTHON_PATH|/Users/yourname/.local/venvs/jobspy-custom-3.12/bin/python|g" \
      ~/Library/LaunchAgents/com.jobspy-custom.pipeline.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jobspy-custom.pipeline.plist

  To test immediately instead of waiting for 8am:
    launchctl kickstart -k gui/$(id -u)/com.jobspy-custom.pipeline

  To remove:
    launchctl bootout gui/$(id -u)/com.jobspy-custom.pipeline
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobspy-custom.pipeline</string>

    <key>ProgramArguments</key>
    <array>
        <string>REPLACE_WITH_PYTHON_PATH</string>
        <string>REPLACE_WITH_REPO_PATH/run_pipeline.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>REPLACE_WITH_REPO_PATH</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>REPLACE_WITH_REPO_PATH/pipeline_cron.log</string>
    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_REPO_PATH/pipeline_cron.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:REPLACE_WITH_HOME_DIR/.local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
